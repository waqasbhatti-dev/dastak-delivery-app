rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Advertisement media: Only authorized admin can upload, replace, or delete
    match /advertisements/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
                      request.auth.token.email.lower() in ['mwaqasbhatti1230@gmail.com', 'mwaqasbhatti57570@gmail.com'];
    }

    // Rider CNIC photos: rider can write to their own folder; authorized admin can also manage
    match /riders/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email.lower() in ['mwaqasbhatti1230@gmail.com', 'mwaqasbhatti57570@gmail.com']);
    }

    // Bill photos and payment screenshots for orders
    match /orders/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Default: Authenticated users can read/write their resources
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}

