rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
             ('email' in request.auth.token) &&
             (request.auth.token.email.lower() == 'mwaqasbhatti1230@gmail.com');
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isMedia() {
      return request.resource.contentType.matches('image/.*') ||
             request.resource.contentType.matches('video/.*');
    }

    // 1. Advertisement media:
    // Any authenticated user can read/view published ads.
    // ONLY the sole authorized admin can upload, modify, or delete ads.
    // Validates media type (image/video) and 26MB max file size.
    match /advertisements/{fileName} {
      allow read: if isSignedIn();
      allow write: if isAdmin() &&
                      isMedia() &&
                      request.resource.size < 26 * 1024 * 1024;
    }

    // 2. Rider CNIC identity documents:
    // Only the rider owner (request.auth.uid == userId) OR the authorized admin can read.
    // Only the rider owner can upload/write to their own folder.
    // Validates image content type and 10MB max file size.
    match /riders/{userId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() &&
                      request.auth.uid == userId &&
                      isImage() &&
                      request.resource.size < 10 * 1024 * 1024;
    }

    // 3. Order media (receipts, delivery photos, item photos):
    // Scoped by orderId and uploader userId: orders/{orderId}/{userId}/{fileName}
    // Only the uploader OR the authorized admin can read/write.
    match /orders/{orderId}/{userId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() &&
                      request.auth.uid == userId &&
                      isImage() &&
                      request.resource.size < 10 * 1024 * 1024;
    }

    // Direct order path fallback: orders/{orderId}/{fileName}
    // Restricted to the authorized admin only.
    match /orders/{orderId}/{fileName} {
      allow read: if isAdmin();
      allow write: if isAdmin() && isImage() && request.resource.size < 10 * 1024 * 1024;
    }

    // Global Catch-All: Deny by default for all unmatched paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
